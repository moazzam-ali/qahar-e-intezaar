<?xml version="1.0" encoding="utf-8"?>
<!--
  AppWidget metadata.

  - updatePeriodMillis: Android clamps this to a 30-minute minimum (1_800_000ms).
    Anything smaller is silently ignored. We declare the real minimum here and
    rely on the AlarmManager tick in QaharWidgetProvider for per-minute freshness
    of the magnitude line. The live seconds tick comes from a Chronometer view,
    which the OS animates frame-by-frame without waking the provider.
  - previewLayout: must be a fully-static, RemoteViews-safe layout — Samsung's
    One UI picker renders this in its own process before the user accepts the
    add. Anything that fails to inflate here surfaces as "Could not add widget"
    in the picker. We point at a separate, deliberately conservative layout.
  - initialLayout: the runtime view, bound by our provider after the user
    accepts the add. May safely use Chronometer etc.
  - widgetCategory: home_screen — keyguard is deprecated.
  - resizeMode: horizontal|vertical so the user can size on a 4x2 if they want.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:initialLayout="@layout/qahar_widget_layout"
    android:previewLayout="@layout/qahar_widget_preview"
    android:description="@string/qahar_widget_description"
    android:minWidth="110dp"
    android:minHeight="110dp"
    android:minResizeWidth="110dp"
    android:minResizeHeight="110dp"
    android:targetCellWidth="2"
    android:targetCellHeight="2"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen"
    android:updatePeriodMillis="1800000" />
