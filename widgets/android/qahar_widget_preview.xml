<?xml version="1.0" encoding="utf-8"?>
<!--
  Picker preview only. Strictly @RemoteView-safe widgets, no Chronometer, no
  Space, no custom font features. Samsung's One UI widget picker renders this
  in its OWN process; anything fancy here can manifest as "Could not add
  widget" with a gray tile. The runtime layout (qahar_widget_layout.xml) is
  free to use richer views since it's bound after the user accepts the add.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@drawable/qahar_widget_bg">

  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="horizontal"
      android:gravity="center_vertical">

    <ImageView
        android:layout_width="6dp"
        android:layout_height="6dp"
        android:layout_marginEnd="8dp"
        android:src="@drawable/qahar_widget_dot"
        android:contentDescription="@null" />

    <TextView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textColor="#6B6358"
        android:textSize="12sp"
        android:singleLine="true"
        android:ellipsize="end"
        android:text="Qahar-e-Hijr" />
  </LinearLayout>

  <TextView
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginTop="24dp"
      android:textColor="#2A2520"
      android:textSize="22sp"
      android:singleLine="true"
      android:text="12d · 4h · 23m" />

  <TextView
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginTop="2dp"
      android:textColor="#6B6358"
      android:textSize="13sp"
      android:singleLine="true"
      android:text="42:17" />

  <TextView
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="2dp"
      android:textColor="#A89F90"
      android:textSize="11sp"
      android:singleLine="true"
      android:text="since 5 Apr 2026" />
</LinearLayout>
